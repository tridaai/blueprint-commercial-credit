# Postgres profile (unset = local SQLite store at CREDIT_SQLITE_PATH)
# DATABASE_URL=postgresql://credit:credit-local-only@localhost:5432/credit
CREDIT_SQLITE_PATH=./data/credit.db

# Document store (unset bucket = in-process local document store)
# S3_ENDPOINT_URL=http://minio:8333
# S3_BUCKET=credit-documents
S3_REGION=us-east-1
